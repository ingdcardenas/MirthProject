# Copiar este archivo a .env y ajustar valores.
# NUNCA commitear el .env real (ver .gitignore).

# URL base del servidor Mirth Connect (API REST, motor Jersey).
# Si se deja vacio/sin definir, login.sh la pregunta interactivamente
# (default: localhost, puerto 8443).
MIRTH_URL=https://localhost:8443

# Usuario de Mirth Connect (la contraseña se pide de forma interactiva,
# nunca se guarda en texto plano aqui). Si se deja vacio, los scripts
# preguntaran el usuario tambien de forma interactiva.
MIRTH_USER=admin

# Si la contraseña se quiere pasar por entorno en vez de interactiva
# (NO recomendado, solo para pipelines controlados), exportar antes de
# correr los scripts: export MIRTH_PASSWORD='...'
# MIRTH_PASSWORD=

# Ruta del cookie jar PERSISTENTE de sesion. Se crea/renueva con ./login.sh
# (permisos 600), se reutiliza en test-conexion.sh / import-canal.sh /
# export-canal.sh SIN pedir credenciales de nuevo, y se borra recien al
# correr ./logout.sh. Default si no se define: ${SCRIPT_DIR}/.mirth-session
# (dentro de esta carpeta, ignorado por git). Alternativa recomendada fuera
# del repo: ~/.cache/mirth/session
# MIRTH_COOKIE_JAR=/home/usuario/.cache/mirth/session

# Verificacion TLS: el certificado del servidor es autofirmado, por eso
# los scripts usan -k. Dejar en "true" salvo que se instale el certificado
# real en el sistema.
MIRTH_INSECURE_TLS=true

# Carpeta donde se guardan los XML de canales importados (descargados desde Mirth)
MIRTH_CANALES_DIR=./canales
